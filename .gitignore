# RoboPRO-specific
# Asset binaries (objects/embodiments/textures) are not tracked in git;
# they're fetched separately at install time. See docs/install.html Step 3.
benchmark/assets
benchmark/assets/
benchmark_data/*
!benchmark_data/.gitkeep
benchmark/collision_test/
benchmark/bench_script/collision_test/
benchmark/test_output/
presentation_material/

# External pi05/OpenPI implementation and local model artifacts. Keep the
# vendor tree ignored, but track the small RoboPRO-owned runtime adapters.
/customized_robotwin/policy/pi05/*
!/customized_robotwin/policy/pi05/__init__.py
!/customized_robotwin/policy/pi05/deploy_policy.py
!/customized_robotwin/policy/pi05/deploy_policy.yml
!/customized_robotwin/policy/pi05/pi_model.py
!/customized_robotwin/policy/pi05/eval.sh
!/customized_robotwin/policy/pi05/eval_double_env.sh
!/customized_robotwin/policy/pi05/collect_rollout.sh
/customized_robotwin/policy/robopro_jax_30000/
/policy/

# Local experiment workspaces. Track the reproducible graph-conditioned pi05
# runtime, but keep other workspaces and generated evaluation runs ignored.
/experiments/*
!/experiments/graph_conditioned_pi05/
/experiments/graph_conditioned_pi05/evaluation/runs/

tmp/
usecase_roadmap.tex
related_works.tex

# Validation outputs (generated, not tracked)
customized_robotwin/**/data/action_validation_suite*/
customized_robotwin/**/data/relation_validation*/
scripts/validation/results/
docs/objaverse_preview/
docs/references/
docs/paper_plan/

# Reference materials (paper LaTeX + external links, not tracked)
references/

# Node-local Docker image export used by Slurm compute nodes.
/docker/gb10/robopro-gb10.tar
